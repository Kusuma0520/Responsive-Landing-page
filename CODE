* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: Arial, sans-serif;
}

/* Navbar */
#navbar {
  position: fixed;
  top: 0;
  width: 100%;
  padding: 15px 50px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: transparent;
  transition: 0.3s ease;
  z-index: 1000;
}

#navbar.scrolled {
  background: #333;
}

.logo {
  color: white;
  font-size: 24px;
  font-weight: bold;
}

.nav-links {
  list-style: none;
  display: flex;
}

.nav-links li {
  margin-left: 20px;
}

.nav-links a {
  text-decoration: none;
  color: white;
  padding: 8px 12px;
  transition: 0.3s;
}

/* Hover Effect */
.nav-links a:hover {
  background: #fff;
  color: #333;
  border-radius: 5px;
}

/* Sections */
.section {
  height: 100vh;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 2rem;
}
####CSS....
/* Different section colors */
#home { background: #1abc9c; }
#about { background: #3498db; }
#services { background: #9b59b6; }
#contact { background: #e74c3c; }

/* Responsive */
@media (max-width: 768px) {
  #navbar {
    flex-direction: column;
  }

  .nav-links {
    flex-direction: column;
    margin-top: 10px;
  }

  .nav-links li {
    margin: 10px 0;
  }
}
